+    QStringList manuallyAuthorizedDevicePaths;
+
+#if defined(Q_OS_MACOS)
+    if (Sandbox::enabled()) {
+        SettingsDAO settings(m_pTrackCollection->database());
+        const QString savedRoots = settings.getValue(kSandboxUsbRootsSettingsKey);
+        const QStringList storedRoots = savedRoots.isEmpty()
+                ? QStringList()
+                : savedRoots.split(QChar(';'), Qt::SkipEmptyParts);
+
+        m_rekordboxSecurityTokens.clear();
+        QStringList rootsToPersist;
+        for (const QString& storedRoot : storedRoots) {
+            const QDir rootDir(storedRoot);
+            auto token = Sandbox::openSecurityTokenForDir(rootDir, false);
+            if (!token.isNull() &&
+                    !findRekordboxPdbPath(rootDir.absolutePath()).isEmpty()) {
+                m_rekordboxSecurityTokens.append(token);
+                manuallyAuthorizedDevicePaths.append(rootDir.absolutePath());
+                rootsToPersist.append(rootDir.absolutePath());
+            }
+        }
+
+        bool automaticallyDiscoverable = false;
+        const QFileInfoList mountedVolumes =
+                QDir(QStringLiteral("/Volumes"))
+                        .entryInfoList(QDir::AllDirs | QDir::NoDotAndDotDot);
+        for (const QFileInfo& volume : mountedVolumes) {
+            if (!findRekordboxPdbPath(volume.absoluteFilePath()).isEmpty()) {
+                automaticallyDiscoverable = true;
+                break;
+            }
+        }
+
+        if (!automaticallyDiscoverable &&
+                manuallyAuthorizedDevicePaths.isEmpty()) {
+            const QString selectedPath = QFileDialog::getExistingDirectory(nullptr,
