+                        rekordboxDeviceRootFromSelection(selectedPath);
+                if (deviceRoot.isEmpty()) {
+                    QMessageBox::warning(nullptr,
+                            tr("Invalid Rekordbox USB drive"),
+                            tr("The selected folder does not contain "
+                               "PIONEER/rekordbox/export.pdb."));
+                } else {
+                    const QDir rootDir(deviceRoot);
+                    if (Sandbox::createSecurityTokenForDir(rootDir)) {
+                        auto token =
+                                Sandbox::openSecurityTokenForDir(rootDir, false);
+                        if (!token.isNull()) {
+                            m_rekordboxSecurityTokens.append(token);
+                            manuallyAuthorizedDevicePaths.append(deviceRoot);
+                            if (!rootsToPersist.contains(deviceRoot)) {
+                                rootsToPersist.append(deviceRoot);
+                            }
+                        }
+                    }
+                }
+            }
+        }
+
+        if (!rootsToPersist.isEmpty()) {
+            settings.setValue(kSandboxUsbRootsSettingsKey,
+                    rootsToPersist.join(QChar(';')));
