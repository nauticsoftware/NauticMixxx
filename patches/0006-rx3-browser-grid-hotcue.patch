+class Rx3CategoryDelegate : public QStyledItemDelegate {
+  public:
+    using QStyledItemDelegate::QStyledItemDelegate;
+    void paint(QPainter* p, const QStyleOptionViewItem& option, const QModelIndex& index) const override {
+        p->save();
+        const bool selected=option.state & QStyle::State_Selected;
+        p->fillRect(option.rect, QColor(selected?"#006f88":"#202020"));
+        if(selected) p->fillRect(QRect(option.rect.topLeft(),QSize(4,option.rect.height())),Qt::white);
+        const QString label=index.data().toString().section('\n',1);
+        const qreal scale=option.rect.height()/65.0;
+        const qreal cx=option.rect.center().x(), cy=option.rect.y()+22*scale;
+        p->setRenderHint(QPainter::Antialiasing);
+        p->setPen(QPen(Qt::white,1.5*scale));p->setBrush(Qt::NoBrush);
+        if(label=="ARTIST") {
+            p->drawEllipse(QPointF(cx,cy-6*scale),5*scale,5*scale);
+            p->drawArc(QRectF(cx-11*scale,cy+2*scale,22*scale,15*scale),0,180*16);
+        } else if(label=="ALBUMS") {
+            p->drawRect(QRectF(cx-11*scale,cy-11*scale,22*scale,22*scale));
+            p->drawEllipse(QPointF(cx,cy),7*scale,7*scale);
+            p->drawEllipse(QPointF(cx,cy),1*scale,1*scale);
+        } else {
+            QFont icon("Arial");icon.setPixelSize(qRound(28*scale));p->setFont(icon);
+            p->drawText(QRectF(option.rect.x(),option.rect.y()+2*scale,option.rect.width(),36*scale),Qt::AlignCenter,index.data().toString().section('\n',0,0));
+        }
+        QFont font("Arial");font.setPixelSize(qMax(9,qRound(11*scale)));p->setFont(font);
+        p->drawText(option.rect.adjusted(4,qRound(37*scale),-4,-4),Qt::AlignHCenter|Qt::AlignTop,label);
+        p->restore();
+    }
+};
