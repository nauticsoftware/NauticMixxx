+class Rx3TrackDelegate : public QStyledItemDelegate {
+  public:
+    Rx3TrackDelegate(WTrackTableView* view, AnalysisDao* dao)
+            : QStyledItemDelegate(view), m_view(view), m_dao(dao), m_cache(256) {}
+    void paint(QPainter* p, const QStyleOptionViewItem& option, const QModelIndex& index) const override {
+        p->save();
+        const bool selected = option.state & QStyle::State_Selected;
+        p->fillRect(option.rect, selected ? QColor("#008bea") : QColor(index.row() % 2 ? "#262626" : "#000000"));
+        const QString field = m_view->columnNameOfIndex(index);
+        if (field == "preview") {
+            auto* model = dynamic_cast<TrackModel*>(m_view->model());
+            ConstWaveformPointer wave;
+            const auto id = model ? model->getTrackId(index) : TrackId();
+            if (m_cache.contains(id)) wave = *m_cache.object(id);
+            if (!wave && id.isValid() && !m_cache.contains(id) && !m_pending.contains(id)) {
+                m_pending.insert(id);
+                // Read stored summaries only: getTrack() can hydrate cloud
+                // audio and emit metadata changes, causing a repaint loop.
+                QTimer::singleShot(0, const_cast<Rx3TrackDelegate*>(this), [this, id] {
+                    ConstWaveformPointer summary;
+                    const auto analyses = m_dao->getAnalysesForTrackByType(id, AnalysisDao::TYPE_WAVESUMMARY);
+                    for (const auto& analysis : analyses) {
+                        if (WaveformFactory::waveformSummaryVersionToVersionClass(analysis.version) == WaveformFactory::VC_USE) {
+                            summary = ConstWaveformPointer(WaveformFactory::loadWaveformFromAnalysis(analysis));
+                            break;
+                        }
+                    }
+                    m_cache.insert(id, new ConstWaveformPointer(summary));
+                    m_pending.remove(id);
+                    m_view->viewport()->update();
+                });
+            }
+            const QRect r = option.rect.adjusted(6, 6, -6, -4);
+            p->setPen(QColor("#aaa")); p->drawLine(r.bottomLeft(), r.bottomRight());
+            if (wave && wave->getCompletion() > 1) {
+                const int count = qMin(wave->getCompletion(), wave->getDataSize());
+                for (int x = 0; x < r.width(); ++x) {
+                    int all = 0, low = 0, mid = 0, high = 0;
+                    const int first = x * count / r.width();
+                    const int last = qMin(count, qMax(first + 1, (x + 1) * count / r.width()));
+                    for (int i = first; i < last; ++i) {
+                        all = qMax(all, int(wave->getAll(i)));
+                        low = qMax(low, int(wave->getLow(i)));
+                        mid = qMax(mid, int(wave->getMid(i)));
+                        high = qMax(high, int(wave->getHigh(i)));
+                    }
+                    rx3::drawSummaryColumn(p, r.x()+x, r.bottom(),
+                            r.height()/255.0, all, low, mid, high);
+                }
+            }
+        } else {
+            QString label = field == "tracknumber" ? QString::number(index.row()+1).rightJustified(3, '0') : index.data().toString();
+            if (field == "title") label.prepend(QString::fromUtf8("♪  "));
+
+            QFont font("Arial"); font.setPixelSize(qMax(12, option.rect.height()/2)); p->setFont(font);
+            p->setPen(Qt::white);
+            QRect r = option.rect.adjusted(7, 0, -6, 0);
+            if (field == "artist") {
+                const qreal unit = option.rect.height()/48.0;
+                const QPointF c(r.x()+9*unit, r.center().y()-5*unit);
+                p->setRenderHint(QPainter::Antialiasing);
+                p->setPen(QPen(Qt::white,unit)); p->setBrush(Qt::NoBrush);
+                p->drawEllipse(c,4*unit,4*unit);
+                p->drawArc(QRectF(c.x()-9*unit,c.y()+6*unit,18*unit,12*unit),0,180*16);
+                r.adjust(qRound(26*unit),0,0,0);
+            }
+            p->drawText(r, Qt::AlignLeft | Qt::AlignVCenter, QFontMetrics(font).elidedText(label, Qt::ElideRight, r.width()));
+        }
+        p->restore();
+    }
+    QWidget* createEditor(QWidget*, const QStyleOptionViewItem&, const QModelIndex&) const override { return nullptr; }
+  private:
+    WTrackTableView* m_view;
+    AnalysisDao* m_dao;
+    mutable QCache<TrackId, ConstWaveformPointer> m_cache;
+    mutable QSet<TrackId> m_pending;
+};
