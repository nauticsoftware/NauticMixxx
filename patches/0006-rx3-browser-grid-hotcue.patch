+        QTimer::singleShot(0, this, [this]{ populateCategories(); refreshTable(); });
+        connect(m_sidebar->model(), &QAbstractItemModel::rowsInserted, this, [this]{ if(m_pages->currentIndex()==1) refreshSources(); });
+        connect(m_sidebar->model(), &QAbstractItemModel::rowsRemoved, this, [this]{ if(m_pages->currentIndex()==1) refreshSources(); });
