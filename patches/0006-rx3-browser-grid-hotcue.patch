+void WTrackTableView::setRx3Browser(bool enabled) {
+    m_rx3Browser = enabled;
+    setProperty("rx3Browser", enabled);
+    if (!enabled || !model()) return;
+    const auto* tm = getTrackModel();
+    if (!tm) return;
+    for (const auto& field : {LIBRARYTABLE_PREVIEW, LIBRARYTABLE_TRACKNUMBER, LIBRARYTABLE_TITLE, LIBRARYTABLE_ARTIST}) {
+        const int column = tm->fieldIndex(field);
+        if (column < 0) continue;
+        if (!dynamic_cast<Rx3TrackDelegate*>(itemDelegateForColumn(column))) {
+            auto* old = itemDelegateForColumn(column);
+            setItemDelegateForColumn(column, new Rx3TrackDelegate(this, &m_pLibrary->trackCollectionManager()->internalCollection()->getAnalysisDAO()));
+            if (old && old != itemDelegate()) old->deleteLater();
+        }
+    }
+    setShowGrid(false);
+    setAlternatingRowColors(true);
+    verticalHeader()->hide();
+    horizontalHeader()->setStretchLastSection(true);
+    setHorizontalScrollBarPolicy(Qt::ScrollBarAlwaysOff);
+    applyRx3Columns();
+}
+
+void WTrackTableView::applyRx3Columns() {
+    if (!m_rx3Browser || !model()) return;
+    const auto* tm = getTrackModel();
+    if (!tm) return;
+    const QStringList fields = {LIBRARYTABLE_PREVIEW, LIBRARYTABLE_COVERART, LIBRARYTABLE_TRACKNUMBER, LIBRARYTABLE_TITLE, LIBRARYTABLE_ARTIST};
+    for (int c = 0; c < model()->columnCount(); ++c) {
+        setColumnHidden(c, !fields.contains(model()->headerData(c, Qt::Horizontal, TrackModel::kHeaderNameRole).toString()));
+    }
+    const double scale = qMax(0.6, double(height()) / 638.0);
+    const int row = qRound(48 * scale);
+    verticalHeader()->setMinimumSectionSize(row);
+    verticalHeader()->setDefaultSectionSize(row);
+    horizontalHeader()->setFixedHeight(row);
+    int position = 0;
+    for (const auto& field : fields) {
+        const int c = tm->fieldIndex(field);
+        if (c < 0) continue;
+        horizontalHeader()->moveSection(horizontalHeader()->visualIndex(c), position++);
+        int w = field == "preview" ? qRound(208*scale) : field == "coverart" ? row : field == "tracknumber" ? qRound(54*scale) : qMax(100, (viewport()->width()-qRound(310*scale))/2);
+        horizontalHeader()->resizeSection(c, w);
+    }
+}
