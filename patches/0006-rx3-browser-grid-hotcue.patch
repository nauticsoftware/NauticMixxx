+        for(int i=0;i<m_categories->count();++i) m_categories->item(i)->setSizeHint(QSize(qRound(92*scale),qRound(65*scale)));
+        refreshTable();
+    }
+    bool eventFilter(QObject* watched, QEvent* event) override {
+        if(event->type() == QEvent::FocusIn || event->type() == QEvent::MouseButtonPress) {
+            if(watched==m_categories) m_focus=0;
+            else if(watched==m_sidebar) m_focus=1;
+            else if(watched==m_sources) m_focus=3;
+            else if(watched==m_facets) m_focus=4;
+            else m_focus=2;
+        }
+        if(event->type() == QEvent::KeyPress) {
+            auto* key = static_cast<QKeyEvent*>(event);
+            if (key->key()==Qt::Key_Return || key->key()==Qt::Key_Enter) { enter(); return true; }
+            if (key->key()==Qt::Key_Left || key->key()==Qt::Key_Escape) { back(); return true; }
+        }
+        return QWidget::eventFilter(watched,event);
+    }
+  private:
+    ControlObject* makeControl(const QString& name, std::function<void(double)> handler, bool ignoreNops=false) {
+        auto control = std::make_unique<ControlObject>(ConfigKey("[RX3Browser]", name), ignoreNops);
+        auto* ptr = control.get();
+        connect(ptr, &ControlObject::valueChanged, this, [handler](double value){handler(value);});
+        m_controls.push_back(std::move(control)); return ptr;
+    }
+    SidebarModel* model() const { return qobject_cast<SidebarModel*>(m_sidebar->model()); }
+    void populateCategories() {
+        const int selected = qMax(0,m_categories->currentRow());
+        m_categories->clear(); m_roots.clear();m_facetFields.clear();
+        auto* sm = model(); if(!sm) return;
+        if(m_selectedDevice.isValid()) {
+            for(const auto& label : {QString("♪\nTRACK"),QString("♫\nPLAYLIST")}) {
+                auto* item=new QListWidgetItem(label,m_categories);
+                item->setTextAlignment(Qt::AlignCenter);item->setSizeHint(QSize(94,65));
+                m_roots.push_back(m_selectedDevice);m_facetFields.push_back(QString());
+            }
+            m_categories->setCurrentRow(qMin(selected,1));
+            selectCategory(m_categories->currentRow());
+            return;
+        }
+        for(int i=0;i<sm->rowCount();++i) {
+            const auto index = sm->index(i,0);
+            const QString feature=index.data(SidebarModel::IconNameRole).toString();
+            const QMap<QString,QString> labels={{"tracks","TRACK"},{"playlist","PLAYLIST"},{"crates","CRATES"},{"computer","FOLDER"},{"recordings","REC"},{"history","HISTORY"},{"rekordbox","REKORDBOX"}};
+            if(!labels.contains(feature)) continue;
+            const QString name=labels.value(feature);
+            QString icon = "♪";
+            if(feature=="playlist") icon="♫";
+            else if(feature=="computer") icon="▱";
+            else if(feature=="history") icon="◷";
+            else if(feature=="recordings") icon="◎";
+            auto* item = new QListWidgetItem(icon+"\n"+name.toUpper(),m_categories);
+            item->setTextAlignment(Qt::AlignCenter); item->setSizeHint(QSize(94,65));
+            m_roots.push_back(index);m_facetFields.push_back(QString());
+            if(feature=="tracks") {
+                for(const auto& field : {QString("artist"),QString("album"),QString("key")}) {
+                    auto* facet=new QListWidgetItem(field=="album"?"▣\nALBUMS":field=="artist"?"♙\nARTIST":"♭\nKEY",m_categories);
+                    facet->setTextAlignment(Qt::AlignCenter);facet->setSizeHint(QSize(94,65));
+                    m_roots.push_back(index);m_facetFields.push_back(field);
+                }
+            }
+        }
+        m_categories->setCurrentRow(qMin(selected,m_categories->count()-1));
+        if(!m_roots.empty()) selectCategory(m_categories->currentRow());
+    }
+    void refreshTable() {
+        if(auto* table=m_library->getCurrentTrackTableView()) {
+            table->setRx3Browser(true);table->viewport()->installEventFilter(this);
+            if(!table->property("rx3ModelConnected").toBool()) {
+                table->setProperty("rx3ModelConnected",true);
+                connect(table,&WTrackTableView::rx3ModelChanged,this,[this]{m_loading->hide();m_library->show();refreshTable();updateTrackInfo();});
+                connect(table->selectionModel(),&QItemSelectionModel::currentRowChanged,this,[this]{updateTrackInfo();});
+            }
+        }
+    }
+    void updateTrackInfo() {
+        if(!m_trackInfo->isVisible()) return;
+        QString text="INFO";
+        if(auto* table=m_library->getCurrentTrackTableView()) {
+            const int row=table->currentIndex().row();
+            if(row>=0) for(int col=0;col<table->model()->columnCount();++col) {
+                const QString name=table->model()->headerData(col,Qt::Horizontal,TrackModel::kHeaderNameRole).toString();
+                if(QStringList{"title","artist","album","genre","bpm","key"}.contains(name))
+                    text+="\n\n"+name.toUpper()+"\n"+table->model()->index(row,col).data().toString();
+            }
+        }
+        m_trackInfo->setText(text);
+    }
+    void activate(const QModelIndex& index) {
+        if(!index.isValid()) return;
+        m_sidebar->selectIndex(index);
+        model()->clicked(index);
+        m_breadcrumb->setText(index.data(SidebarModel::IconNameRole).toString() == "tracks" ? "COLLECTION / TRACK" : index.data().toString());
+        QTimer::singleShot(0,this,[this]{refreshTable();});
+    }
+    void selectCategory(int row) {
+        if(row<0 || row>=int(m_roots.size())) return;
+        const QModelIndex root=m_roots[row]; if(!root.isValid()) return;
+        m_loading->hide();m_library->show();
+        m_library->search(QString());m_facets->hide();m_facetField.clear();
+        if(!m_facetFields[row].isEmpty()) {showFacet(m_facetFields[row],root);return;}
+        m_pages->setCurrentIndex(0); m_sidebar->setRootIndex(root);
+        m_sidebar->setVisible(m_selectedDevice.isValid() ? row==1 :
+                root.data(SidebarModel::IconNameRole).toString() != "tracks" && model()->hasChildren(root));
+        activate(root);
+        m_focus=m_sidebar->isVisible()?1:2;
+        if(m_focus==2) focusTracks(); else {
+            m_sidebar->setFocus();
+            if(model()->rowCount(root)>0) activate(model()->index(0,0,root));
+        }
+    }
+    void showFacet(const QString& field,const QModelIndex& root) {
+        // Field comes only from the fixed ARTIST/ALBUM/KEY category list.
+        m_facetField=field;m_sidebar->hide();m_facets->clear();m_facets->show();
+        m_pages->setCurrentIndex(0);activate(root);
+        QSqlQuery query(m_backend->trackCollectionManager()->internalCollection()->database());
+        if(query.exec(QString("SELECT DISTINCT \"%1\" FROM library WHERE mixxx_deleted=0 AND \"%1\" IS NOT NULL AND \"%1\"<>'' ORDER BY \"%1\" COLLATE NOCASE").arg(field))) {
+            while(query.next()) {auto* item=new QListWidgetItem(query.value(0).toString(),m_facets);item->setSizeHint(QSize(260,44));}
+        }
+        m_breadcrumb->setText(field.toUpper());m_focus=4;m_facets->setFocus();
+        if(m_facets->count()) {m_facets->setCurrentRow(0);filterFacet();}
+    }
+    void filterFacet() {
+        if(!m_facets->currentItem()) return;
+        QString value=m_facets->currentItem()->text();
+        value.replace("\""," ");
+        m_library->search(m_facetField+":\""+value+"\"");
+        m_breadcrumb->setText(m_facetField.toUpper()+" / "+m_facets->currentItem()->text());
+        refreshTable();
+    }
+    void chooseFacet() {filterFacet();focusTracks();}
+    void focusTracks() {
+        refreshTable(); m_focus=2;
+        if(auto* table=m_library->getCurrentTrackTableView()) {
+            table->setFocus();
+            if(!table->currentIndex().isValid() && table->model()->rowCount()>0) table->setCurrentIndex(table->model()->index(0,0));
+        }
+    }
+    void showSources() {
+        m_pages->setCurrentIndex(1);m_breadcrumb->setText("SOURCE");m_focus=3;
+        refreshSources();
+        // Device discovery is lazy in Mixxx. Entering SOURCE must request it,
+        // even when the user has never selected the native Rekordbox feature.
+        for(int i=0;i<model()->rowCount();++i) {
+            const auto root=model()->index(i,0);
+            if(root.data(SidebarModel::IconNameRole).toString()=="rekordbox") {model()->clicked(root);break;}
+        }
+        m_sources->setFocus();
+    }
+    void refreshSources() {
+        if(m_refreshingSources) return;
+        m_refreshingSources=true;
+        const int previous=qMax(0,m_sources->indexOfTopLevelItem(m_sources->currentItem()));
+        m_sources->clear();m_devices.clear();
+        new QTreeWidgetItem(m_sources,{"▣   SOFTWARE CONTROL                  ›"});
+        m_devices.push_back(QPersistentModelIndex());
+        // Enumerate current feature indexes, since a provider may have reset
+        // its child model during discovery.
+        for(int i=0;i<model()->rowCount();++i) {
+            const auto root=model()->index(i,0);
+            if(root.data(SidebarModel::IconNameRole).toString()!="rekordbox") continue;
+            for(int r=0;r<model()->rowCount(root);++r) {
+                const auto device=model()->index(r,0,root);
+                new QTreeWidgetItem(m_sources,{"▣   "+device.data().toString()+"                  ›"});
+                m_devices.push_back(device);
+            }
+        }
+        m_sources->setCurrentItem(m_sources->topLevelItem(qMin(previous,m_sources->topLevelItemCount()-1)));
+        m_refreshingSources=false;
+        updateSourceInfo(qMin(previous,m_sources->topLevelItemCount()-1));
+    }
+    void updateSourceInfo(int row) {
+        if(m_refreshingSources) return;
+        QString songs="—",playlists="—",total="—",available="—";
+        QString source="SOFTWARE CONTROL";
+        if(row==0) {
+            QSqlQuery query(m_backend->trackCollectionManager()->internalCollection()->database());
+            if(query.exec("SELECT count(*) FROM library WHERE mixxx_deleted=0") && query.next()) songs=query.value(0).toString();
+            if(query.exec("SELECT count(*) FROM Playlists WHERE hidden=0") && query.next()) playlists=query.value(0).toString();
+        } else if(row>0 && row<int(m_devices.size())) {
+            source=m_devices[row].data().toString();
+            const auto data=m_devices[row].data(SidebarModel::DataRole).toList();
+            if(!data.isEmpty()) {
+                QStorageInfo volume(data.first().toString());
+                if(volume.isValid() && volume.isReady()) {
+                    total=QString::number(volume.bytesTotal()/1e9,'f',1);
+                    available=QString::number(volume.bytesAvailable()/1e9,'f',1);
+                }
+            }
+        }
+        m_info->setText("INFO\n\n"+source+"\n\nSongs                 "+songs+"\n\nPlaylists              "+playlists+"\n\nTotal                   "+total+" GB\n\nAvailable             "+available+" GB\n\nBackground Color    ○ Default");
+    }
+    void chooseSource() {
+        const int row=m_sources->indexOfTopLevelItem(m_sources->currentItem());
+        if(row<0 || row>=int(m_devices.size())) return;
+        m_pages->setCurrentIndex(0);
+        if(row==0) {m_selectedDevice=QPersistentModelIndex();m_source->setText("▣  SOURCE");populateCategories();selectCategory(0);}
+        else {
+            const QModelIndex device=m_devices[row]; if(!device.isValid()) {showSources();return;}
+            m_selectedDevice=device;
+            m_source->setText("▣  SOURCE");m_facets->hide();
+            populateCategories();
+            m_categories->setCurrentRow(1);
+            m_sidebar->setRootIndex(device);m_sidebar->show();
+            m_focus=1;m_sidebar->setFocus();
+            if(model()->rowCount(device)==0) {
+                m_library->hide();m_loading->setText("Reading USB…");m_loading->show();
+            }
+            QTimer::singleShot(15000,this,[this]{if(m_loading->isVisible()) m_loading->setText("USB unavailable. Open SOURCE to retry.");});
+        }
+    }
+    void move(int delta) {
+        if(m_focus==4) {m_facets->setCurrentRow(qBound(0,m_facets->currentRow()+delta,m_facets->count()-1));filterFacet();return;}
+        if(m_focus==3) {int row=m_sources->indexOfTopLevelItem(m_sources->currentItem()); m_sources->setCurrentItem(m_sources->topLevelItem(qBound(0,row+delta,m_sources->topLevelItemCount()-1)));return;}
+        if(m_focus==0) {m_categories->setCurrentRow(qBound(0,m_categories->currentRow()+delta,m_categories->count()-1));return;}
+        if(m_focus==2) {if(auto* table=m_library->getCurrentTrackTableView()) table->moveSelection(delta);return;}
+        QModelIndex index=m_sidebar->currentIndex();
+        if(!index.isValid() || index==m_sidebar->rootIndex()) index=model()->index(0,0,m_sidebar->rootIndex());
+        for(int n=0;n<qAbs(delta);++n) {
+            const auto next=delta>0?m_sidebar->indexBelow(index):m_sidebar->indexAbove(index);
+            if(next.isValid()) index=next;
+        }
+        activate(index);
+    }
+    void enter() {
+        if(m_focus==4) {chooseFacet();return;}
+        if(m_focus==3) {chooseSource();return;}
+        if(m_focus==0) {selectCategory(m_categories->currentRow());return;}
+        if(m_focus==2) {back();return;}
+        const auto index=m_sidebar->currentIndex();
+        if(index.isValid() && model()->hasChildren(index)) {m_sidebar->setExpanded(index,!m_sidebar->isExpanded(index)); if(m_sidebar->isExpanded(index)) activate(model()->index(0,0,index));}
+        else focusTracks();
+    }
+    void back() {
+        if(m_focus==3) {m_pages->setCurrentIndex(0); m_focus=0; m_categories->setFocus();return;}
+        if(m_focus==2 && m_facets->isVisible()) {m_focus=4;m_facets->setFocus();return;}
+        if(m_focus==2 && m_sidebar->isVisible()) {m_focus=1; m_sidebar->setFocus();return;}
+        if(m_focus==1) {
+            const auto parent=m_sidebar->currentIndex().parent();
+            if(parent.isValid() && parent!=m_sidebar->rootIndex()) {activate(parent);m_sidebar->collapse(parent);return;}
+        }
+        if(m_focus!=0) {m_focus=0;m_categories->setFocus();return;}
+        showSources();
+    }
