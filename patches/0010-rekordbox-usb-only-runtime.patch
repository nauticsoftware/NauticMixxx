+                   "sample rate becomes available";
+        return ImportStatus::Pending;
+    }
+    const bool imported = importPendingWaveformsWhileLocked();
+    locked.unlock();
+    if (imported) {
+        emit waveformUpdated();
+        emit waveformSummaryUpdated();
+    }
+    return ImportStatus::Complete;
