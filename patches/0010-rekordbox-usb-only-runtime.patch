+
+namespace mixxx::rekordbox {
+
+class RekordboxUsbSession;
+
+// Read-only, non-SQL rows for one live Rekordbox USB session. Rekordbox IDs
+// remain provider identities and are never exposed as Mixxx TrackIds.
+class RekordboxRuntimeTrackModel final : public BaseTrackTableModel {
+    Q_OBJECT
+
+  public:
+    RekordboxRuntimeTrackModel(
+            QObject* parent,
+            TrackCollectionManager* pTrackCollectionManager);
+
+    void showAllTracks(std::shared_ptr<RekordboxUsbSession> session);
+    void showPlaylist(std::shared_ptr<RekordboxUsbSession> session,
+            const QList<quint32>& trackIds,
+            quint32 playlistId);
+    void clearSession();
+
+    int rowCount(const QModelIndex& parent = QModelIndex()) const override;
+    TrackPointer getTrack(const QModelIndex& index) const override;
+    TrackPointer getTrackByRef(const TrackRef& trackRef) const override;
+    QUrl getTrackUrl(const QModelIndex& index) const override;
+    QString getTrackLocation(const QModelIndex& index) const override;
+    TrackId getTrackId(const QModelIndex& index) const override;
+    CoverInfo getCoverInfo(const QModelIndex& index) const override;
+    const QVector<int> getTrackRows(TrackId trackId) const override;
+    void search(const QString& searchText) override;
+    const QString currentSearch() const override;
+    bool isColumnInternal(int column) override;
+    Qt::ItemFlags flags(const QModelIndex& index) const override;
+    void copyTracks(const QModelIndexList& indices) const override;
+    const QList<int>& searchColumns() const override;
+    Capabilities getCapabilities() const override;
+    SortColumnId sortColumnIdFromColumnIndex(int index) const override;
+    int columnIndexFromSortColumnId(SortColumnId sortColumn) const override;
+    QString modelKey(bool noSearch) const override;
+    bool updateTrackGenre(Track* pTrack, const QString& genre) const override;
+#if defined(__EXTRA_METADATA__)
+    bool updateTrackMood(Track* pTrack, const QString& mood) const override;
+#endif
+
+    // Browser waveform previews are loaded lazily and asynchronously from the
+    // session. nullptr means not ready yet; an empty vector means that no
+    // supported/valid preview is available. The cache is session-scoped and
+    // never enters SQL or the persistent Track model.
+    const QVector<RuntimeWaveformColumn>* waveformPreview(
+            const QModelIndex& index) const;
+    void requestWaveformPreview(const QModelIndex& index);
+
+  protected:
+    QVariant rawValue(const QModelIndex& index) const override;
+
+  private:
+    void setRows(std::shared_ptr<RekordboxUsbSession> session,
+            QList<RuntimeTrack> rows,
+            QString viewKey);
+    const RuntimeTrack* trackAt(const QModelIndex& index) const;
+
+    std::shared_ptr<RekordboxUsbSession> m_session;
+    QList<RuntimeTrack> m_rows;
+    QList<int> m_searchColumns;
+    QHash<int, SortColumnId> m_sortColumnIds;
+    QHash<int, int> m_columnIndexes;
+    QString m_viewKey{QStringLiteral("rekordbox-usb:empty")};
+    QCache<quint32, QVector<RuntimeWaveformColumn>> m_waveformPreviewCache{128};
+    QSet<quint32> m_pendingWaveformPreviews;
+    quint64 m_previewGeneration{0};
+};
+
+} // namespace mixxx::rekordbox
diff --git a/src/library/rekordbox/rekordboxsessionstate.h b/src/library/rekordbox/rekordboxsessionstate.h
new file mode 100644
index 0000000..104f505
--- /dev/null
+++ b/src/library/rekordbox/rekordboxsessionstate.h
@@ -0,0 +1,114 @@
+#pragma once
+
+#include <QUuid>
+#include <QtGlobal>
+
+#include <atomic>
+#include <utility>
+
+namespace mixxx::rekordbox {
+
+class SessionIdentifier final {
+  public:
+    static SessionIdentifier create() {
+        static std::atomic<quint64> nextGeneration{1};
+        return SessionIdentifier(
+                nextGeneration.fetch_add(1, std::memory_order_relaxed),
+                QUuid::createUuid());
+    }
+
+    SessionIdentifier() = default;
+
+    bool isValid() const {
+        return m_generation != 0 && !m_uuid.isNull();
+    }
+
+    quint64 generation() const {
+        return m_generation;
+    }
+
+    const QUuid& uuid() const {
+        return m_uuid;
+    }
+
+    bool operator==(const SessionIdentifier&) const = default;
+
+  private:
+    SessionIdentifier(quint64 generation, QUuid uuid)
+            : m_generation(generation),
+              m_uuid(std::move(uuid)) {
+    }
+
+    quint64 m_generation{0};
+    QUuid m_uuid;
+};
+
+// A small thread-safe revocation token. It has no audio, filesystem, catalog,
+// UI, or SQL dependencies. State transitions are terminal: no API can restore
+// Active after revoke/invalidate.
+class SessionState final {
+  public:
+    enum class State : quint8 {
+        Active,
+        Revoked,
+        Invalidated,
+    };
+
+    SessionState()
+            : m_identifier(SessionIdentifier::create()) {
+    }
+
+    SessionState(const SessionState&) = delete;
+    SessionState& operator=(const SessionState&) = delete;
+    SessionState(SessionState&&) = delete;
+    SessionState& operator=(SessionState&&) = delete;
+
+    const SessionIdentifier& identifier() const {
+        return m_identifier;
+    }
+
+    State state() const {
+        return m_state.load(std::memory_order_acquire);
+    }
+
+    bool isActive() const {
+        return state() == State::Active;
+    }
+
+    bool isRevoked() const {
+        return state() == State::Revoked;
+    }
+
+    bool isInvalidated() const {
+        return state() == State::Invalidated;
+    }
+
+    bool revoke() {
+        State expected = State::Active;
+        return m_state.compare_exchange_strong(
+                expected,
+                State::Revoked,
+                std::memory_order_acq_rel,
+                std::memory_order_acquire);
+    }
+
+    bool invalidate() {
+        State previous = m_state.load(std::memory_order_acquire);
+        while (previous != State::Invalidated) {
+            if (m_state.compare_exchange_weak(
+                        previous,
+                        State::Invalidated,
+                        std::memory_order_acq_rel,
+                        std::memory_order_acquire)) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+  private:
+    const SessionIdentifier m_identifier;
+    std::atomic<State> m_state{State::Active};
+};
+
+} // namespace mixxx::rekordbox
