+++ b/src/library/rekordbox/rekordboxanlzreader.cpp
@@ -0,0 +1,413 @@
+#include "library/rekordbox/rekordboxanlzreader.h"
+
+#include <QBuffer>
+#include <QCryptographicHash>
+#include <QDateTime>
+#include <QFile>
+#include <QFileInfo>
+#include <QTextCodec>
+#include <QtEndian>
