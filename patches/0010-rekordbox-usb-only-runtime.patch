+
+#include "rekordbox_anlz.h"
+
+namespace mixxx::rekordbox {
+namespace {
+constexpr qint64 kMaxBytes = 64LL * 1024 * 1024;
+quint32 u32(const QByteArray& bytes, qsizetype offset) {
+    if (offset < 0 || offset > bytes.size() - 4) {
+        throw std::runtime_error("Truncated ANLZ integer");
+    }
+    return qFromBigEndian<quint32>(bytes.constData() + offset);
+}
+quint16 u16(const QByteArray& bytes, qsizetype offset) {
+    if (offset < 0 || offset > bytes.size() - 2) {
+        throw std::runtime_error("Truncated ANLZ integer");
+    }
+    return qFromBigEndian<quint16>(bytes.constData() + offset);
+}
+void require(bool condition, const char* message) {
+    if (!condition) {
+        throw std::runtime_error(message);
+    }
+}
+
+constexpr quint16 kMaxCueEntries = 4096;
+
+struct RekordboxCueEntry {
+    quint32 listType{0};
+    quint32 hotCueNumber{0};
+    quint8 pointType{0};
+    quint32 status{0};
+    quint32 timeMs{0};
+    quint32 loopEndMs{0};
+    QString label;
+    mixxx::RgbColor::optional_t color{mixxx::RgbColor::nullopt()};
+};
+
+QString decodeCueComment(
+        const QByteArray& section, qsizetype offset, quint32 length) {
+    if (length == 0) {
+        return {};
+    }
+    require(length >= 2 && length % 2 == 0 &&
+                    quint64(offset) + length <= quint64(section.size()),
+            "Invalid PCO2 UTF-16 comment length");
+    require(section.mid(offset, length).endsWith(QByteArray(2, '\0')),
+            "PCO2 comment is not NUL terminated");
+    QTextCodec::ConverterState state;
+    const auto text = QTextCodec::codecForName("UTF-16BE")->toUnicode(
+            section.constData() + offset, length - 2, &state);
+    require(state.invalidChars == 0 && state.remainingChars == 0 &&
+                    !text.contains(QChar::Null),
+            "Invalid PCO2 UTF-16 comment");
+    return text;
+}
+
+RuntimeCue makeRuntimeCue(const RekordboxCueEntry& entry) {
+    const bool hot = entry.listType == 1;
+    require(entry.listType <= 1, "Unknown cue list type");
+    // Modern Rekordbox exports may mirror slots D-H into PCOB as well as
+    // PCO2. This is present on the real NAUTIC_01 export, so PCOB must not be
+    // restricted to the three slots supported by older players.
+    require(hot ? entry.hotCueNumber >= 1 && entry.hotCueNumber <= 8u
+                : entry.hotCueNumber == 0,
+            "Cue slot disagrees with cue list type");
+    require(entry.pointType == 1 || entry.pointType == 2,
+            "Unknown cue point type");
+    const bool loop = entry.pointType == 2;
+    require(!loop || entry.loopEndMs > entry.timeMs,
+            "Cue loop end does not follow its start");
+
+    RuntimeCue cue;
+    cue.kind = hot ? (loop ? RuntimeCue::Kind::HotLoop
+                           : RuntimeCue::Kind::HotCue)
+                   : (loop ? RuntimeCue::Kind::MemoryLoop
+                           : RuntimeCue::Kind::MemoryCue);
+    cue.hotcueIndex = hot ? static_cast<int>(entry.hotCueNumber) : -1;
+    cue.label = entry.label;
+    cue.color = entry.color;
+    cue.startMs = static_cast<double>(entry.timeMs);
+    if (loop) {
+        cue.endMs = static_cast<double>(entry.loopEndMs);
+    }
+    return cue;
+}
+
+QList<RuntimeCue> decodeCueList(const QByteArray& section,
+        bool extended,
+        quint32 listType,
+        quint16 count) {
+    require(count <= kMaxCueEntries, "Cue count exceeds bounded limit");
+    QList<RuntimeCue> cues;
+    cues.reserve(count);
+    qsizetype offset = extended ? 20 : 24;
+    if (!extended) {
+        require(quint64(offset) + quint64(count) * 56 ==
+                        quint64(section.size()),
+                "PCOB count disagrees with section length");
+    }
+    for (quint16 i = 0; i < count; ++i) {
+        const qsizetype remaining = section.size() - offset;
+        require(remaining >= (extended ? 40 : 56),
+                "Truncated cue entry");
+        require(section.mid(offset, 4) == (extended ? "PCP2" : "PCPT"),
+                "Invalid cue entry tag");
+        const auto entryHeader = u32(section, offset + 4);
+        const auto entryLength = u32(section, offset + 8);
+        require(entryHeader == (extended ? 16u : 28u),
+                "Unexpected cue entry header length");
+        require(entryLength >= (extended ? 40u : 56u) &&
+                        entryLength <= quint64(remaining),
+                "Cue entry exceeds section bounds");
+        if (!extended) {
+            require(entryLength == 56, "Unexpected PCOB entry length");
+        }
+
+        RekordboxCueEntry entry;
+        entry.listType = listType;
+        entry.hotCueNumber = u32(section, offset + 12);
+        if (extended) {
+            entry.pointType = static_cast<quint8>(section.at(offset + 16));
+            entry.timeMs = u32(section, offset + 20);
+            entry.loopEndMs = u32(section, offset + 24);
+            quint32 commentLength = 0;
+            if (entryLength >= 44) {
+                commentLength = u32(section, offset + 40);
+                require(quint64(44) + commentLength <= entryLength,
+                        "PCO2 comment exceeds cue entry");
+                entry.label = decodeCueComment(
+                        section, offset + 44, commentLength);
+            }
+            // Early PCO2 variants may end before the optional color bytes.
+            if (quint64(48) + commentLength <= entryLength) {
+                const auto colorOffset = offset + 44 + commentLength;
+                const auto red = static_cast<quint8>(section.at(colorOffset + 1));
+                const auto green = static_cast<quint8>(section.at(colorOffset + 2));
+                const auto blue = static_cast<quint8>(section.at(colorOffset + 3));
+                // Rekordcrate documents 0/0/0 as "no assigned RGB color".
+                if (red != 0 || green != 0 || blue != 0) {
+                    entry.color = mixxx::RgbColor::optional(
+                            (quint32(red) << 16) | (quint32(green) << 8) |
+                            quint32(blue));
+                }
+            }
+        } else {
+            entry.status = u32(section, offset + 16);
+            require(entry.status == 0 || entry.status == 1 ||
+                            entry.status == 4,
+                    "Unknown PCOB cue status");
+            entry.pointType = static_cast<quint8>(section.at(offset + 28));
+            entry.timeMs = u32(section, offset + 32);
+            entry.loopEndMs = u32(section, offset + 36);
+        }
+        cues.append(makeRuntimeCue(entry));
+        offset += entryLength;
+    }
+    require(offset == section.size(), "Cue list has unexplained trailing bytes");
+    return cues;
+}
+
+QString decodePath(const QByteArray& section) {
+    const auto length = u32(section, 12);
+    require(length >= 2 && length % 2 == 0 && length == section.size() - 16,
+            "Invalid PPTH UTF-16 length");
+    require(section.endsWith(QByteArray(2, '\0')), "PPTH is not NUL terminated");
+    QTextCodec::ConverterState state;
+    const auto text = QTextCodec::codecForName("UTF-16BE")->toUnicode(
+            section.constData() + 16, length - 2, &state);
+    require(state.invalidChars == 0 && state.remainingChars == 0 &&
+                    !text.isEmpty() && !text.contains(QChar::Null),
+            "Invalid PPTH UTF-16 text");
+    return text;
+}
+
+// Validate allocation-driving fields BEFORE entering the generated decoder.
+// Each section is parsed in its own bounded stream, so one bad section cannot
+// consume the next section or erase earlier valid data.
+void decodeSection(const QByteArray& section, quint32 header, quint32 totalLength, AnlzReadResult* result) {
+    const auto tag = section.left(4);
+    if (tag == "PPTH") {
+        require(header == 16, "Unexpected PPTH header length");
+        const auto path = decodePath(section);
+        require(!result->hasPathSection, "Duplicate PPTH section");
+        result->exportedAudioPath = path;
+        result->hasPathSection = true;
+        return;
+    }
+    if (tag == "PQTZ") {
+        require(header == 24, "Unexpected PQTZ header length");
+        const auto count = u32(section, 20);
+        require(count <= 1000000 && quint64(count) * 8 == quint64(section.size() - header),
+                "PQTZ count exceeds bounded payload");
+        require(!result->hadBeatGrid, "Duplicate PQTZ section");
+        kaitai::kstream stream(section.toStdString());
+        rekordbox_anlz_t::tagged_section_t decoded(&stream);
+        const auto* grid = static_cast<rekordbox_anlz_t::beat_grid_tag_t*>(decoded.body());
+        QList<RuntimeBeat> beats;
+        for (const auto& beat : *grid->beats()) {
+            require(beat->beat_number() >= 1 && beat->beat_number() <= 4 && beat->tempo() > 0,
+                    "Invalid PQTZ beat/bar or tempo");
+            require(beats.isEmpty() || beat->time() > beats.last().timeMs,
+                    "Non-increasing PQTZ timestamps");
+            beats.append({beat->time(), beat->beat_number(), beat->tempo()});
+        }
+        result->beats = std::move(beats);
+        result->hadBeatGrid = true;
+        return;
+    }
+    if (tag == "PCOB" || tag == "PCO2") {
+        const bool extended = tag == "PCO2";
+        require(header == (extended ? 20u : 24u), "Unexpected cue list header");
+        const auto type = u32(section, 12);
+        require(type <= 1, "Unknown cue list type");
+        const auto count = u16(section, extended ? 16 : 18);
+        result->hadCueSection = true;
+        const auto cues = decodeCueList(section, extended, type, count);
+        if (extended) {
+            result->pco2Cues.append(cues);
+            if (!result->pco2Cues.isEmpty()) {
+                result->cues = result->pco2Cues;
+            }
+        } else {
+            result->pcobCues.append(cues);
+            if (result->pco2Cues.isEmpty()) {
+                result->cues = result->pcobCues;
+            }
+        }
+        return;
+    }
+    const bool tiny = tag == "PWAV" || tag == "PWV2";
+    const bool preview = tiny || tag == "PWV4" || tag == "PWV6";
+    const bool wave = tiny || tag == "PWV3" || tag == "PWV4" || tag == "PWV5" ||
+            tag == "PWV6" || tag == "PWV7";
+    if (wave) {
+        const quint32 expectedHeader = (tiny || tag == "PWV6") ? 20 : 24;
+        require(header == expectedHeader, "Unexpected waveform header length");
+        const quint32 stride = tiny ? 1 : u32(section, 12);
+        const quint32 count = u32(section, tiny ? 12 : 16);
+        const quint32 expectedStride = tag == "PWV4" ? 6 : tag == "PWV5" ? 2 :
+                (tag == "PWV6" || tag == "PWV7") ? 3 : 1;
+        require(stride == expectedStride && quint64(count) * stride == quint64(totalLength - header),
+                "Waveform dimensions disagree with payload");
+        RuntimeWaveform value;
+        value.sectionTag = tag;
+        value.quality = preview ? RuntimeWaveformQuality::Preview : RuntimeWaveformQuality::Detailed;
+        value.sampleFormat = (tiny || tag == "PWV3") ? RuntimeWaveform::SampleFormat::PackedMono :
+                (tag == "PWV6" || tag == "PWV7") ? RuntimeWaveform::SampleFormat::ThreeBand :
+                                                               RuntimeWaveform::SampleFormat::PackedColor;
+        value.byteOrder = RuntimeWaveform::ByteOrder::BigEndian;
+        value.bytes = section.mid(12);
+        value.headerBytes = section.left(header);
+        value.headerLength = header;
+        value.payloadLength = totalLength - header;
+        value.payloadOffset = header - 12;
+        value.bytesPerEntry = stride;
+        value.entryCount = count;
+        // 150 entries/s documented for scroll data; no invented preview rate.
+        if (!preview) {
+            value.entriesPerSecond = 150.0;
+            value.durationMs = count * 1000.0 / 150.0;
+        }
+        result->waveforms.append(std::move(value));
+        result->hadWaveformSection = true;
+        return;
+    }
+    // PQT2 is not a complete timestamp grid. PWVC is not PWV5/color scroll.
+    // Preserve unknown/unsupported sections verbatim and expose Partial.
+    result->unmappedSections.append({tag, header, section});
+    result->partial = true;
+    result->diagnostics.append(QStringLiteral("Unmapped ANLZ section %1 retained verbatim")
+                                       .arg(QString::fromLatin1(tag)));
+}
+// Sequential bounded reads also fingerprint skipped waveform bytes. This avoids
+// retaining a whole ANLZ or allocating count*stride during descriptor discovery.
+QByteArray readExact(QIODevice* device, qint64 length, QCryptographicHash* hash) {
+    const auto bytes = device->read(length);
+    require(bytes.size() == length, "Truncated ANLZ read");
+    hash->addData(bytes);
+    return bytes;
+}
+
+bool knownWaveform(const QByteArray& tag) {
+    return tag == "PWAV" || tag == "PWV2" || tag == "PWV3" || tag == "PWV4" ||
+            tag == "PWV5" || tag == "PWV6" || tag == "PWV7";
+}
+
+AnlzReadResult readDevice(QIODevice* device, qint64 size, AnlzWaveformReadMode mode,
+        QCryptographicHash* hash) {
+    AnlzReadResult result;
+    try {
+        require(size >= 28 && size <= kMaxBytes, "Invalid or oversized PMAI size");
+        const auto common = readExact(device, 28, hash);
+        require(common.left(4) == "PMAI", "Invalid PMAI header");
+        const auto header = u32(common, 4);
+        require(header >= 28 && header <= quint64(size) && u32(common, 8) == size,
+                "Truncated or inconsistent PMAI length");
+        // Even extended container headers are skipped in bounded chunks.
+        qint64 remainingHeader = header - 28;
+        while (remainingHeader > 0) {
+            const auto count = qMin<qint64>(remainingHeader, 64 * 1024);
+            readExact(device, count, hash);
+            remainingHeader -= count;
+        }
+        result.containerValid = true;
+        quint64 position = header;
+        int sections = 0;
+        while (position < quint64(size)) {
+            require(++sections <= 4096, "ANLZ section count limit exceeded");
+            require(quint64(size) - position >= 12, "Truncated ANLZ section header");
+            auto section = readExact(device, 12, hash);
+            const auto sectionHeader = u32(section, 4);
+            const auto sectionLength = u32(section, 8);
+            require(sectionHeader >= 12 && sectionHeader <= sectionLength &&
+                            sectionLength <= quint64(size) - position,
+                    "ANLZ section exceeds container bounds");
+            // Only the validated small known headers take the descriptor path.
+            const auto tag = section.left(4);
+            const quint32 expectedHeader = (tag == "PWAV" || tag == "PWV2" || tag == "PWV6") ? 20 : 24;
+            const bool deferred = mode == AnlzWaveformReadMode::Descriptor &&
+                    knownWaveform(tag) && sectionHeader == expectedHeader;
+            section += readExact(device, (deferred ? sectionHeader : sectionLength) - 12, hash);
+            const auto previousWaveforms = result.waveforms.size();
+            try {
+                decodeSection(section, sectionHeader, sectionLength, &result);
+            } catch (const std::exception& error) {
+                // Preserve a structurally rejected waveform just like other
+                // unmapped sections. Do not publish an invalid descriptor.
+                if (deferred) {
+                    section += readExact(device, sectionLength - sectionHeader, hash);
+                }
+                result.partial = true;
+                result.unmappedSections.append({tag, sectionHeader, section});
+                result.diagnostics.append(QStringLiteral("%1: %2")
+                                                  .arg(QString::fromLatin1(tag), QString::fromUtf8(error.what())));
+                if (tag == "PPTH") {
+                    result.hasPathSection = false;
+                    result.exportedAudioPath.clear();
+                    result.containerValid = false;
+                    return result;
+                }
+            }
+            if (result.waveforms.size() != previousWaveforms) {
+                auto& waveform = result.waveforms.last();
+                waveform.sectionOffset = position;
+                waveform.payloadDeferred = deferred;
+                if (deferred) {
+                    waveform.bytes.clear();
+                    qint64 remaining = waveform.payloadLength;
+                    while (remaining > 0) {
+                        const auto count = qMin<qint64>(remaining, 64 * 1024);
+                        readExact(device, count, hash);
+                        remaining -= count;
+                    }
+                }
+            }
+            position += sectionLength;
+        }
+    } catch (const std::exception& error) {
+        result.containerValid = false;
+        result.diagnostics.append(QString::fromUtf8(error.what()));
+    }
+    return result;
+}
+} // namespace
+
+AnlzReadResult readAnlz(const QByteArray& bytes) {
+    QBuffer buffer;
+    buffer.setData(bytes);
+    buffer.open(QIODevice::ReadOnly);
+    QCryptographicHash hash(QCryptographicHash::Sha256);
+    return readDevice(&buffer, bytes.size(), AnlzWaveformReadMode::InlineBody, &hash);
+}
+
+AnlzReadResult readAnlzFile(const QString& path, AnlzWaveformReadMode mode) {
+    AnlzReadResult failure;
+    QFile file(path);
+    if (!file.open(QIODevice::ReadOnly) || file.size() < 0 || file.size() > kMaxBytes) {
+        failure.diagnostics.append(QStringLiteral("Cannot read ANLZ or exceeds 64 MiB limit: %1").arg(path));
+        return failure;
+    }
+    const auto expected = file.size();
+    const auto modified = QFileInfo(file).lastModified();
+    const auto canonical = QFileInfo(file).canonicalFilePath();
+    QCryptographicHash hash(QCryptographicHash::Sha256);
+    auto result = readDevice(&file, expected, mode, &hash);
+    if (file.error() != QFileDevice::NoError || file.size() != expected ||
+            QFileInfo(file).lastModified() != modified ||
+            QFileInfo(file).canonicalFilePath() != canonical) {
+        failure.diagnostics.append(QStringLiteral("ANLZ changed or failed during read"));
+        return failure;
+    }
+    if (result.containerValid) {
+        const auto fingerprint = hash.result();
+        for (auto& waveform : result.waveforms) {
+            waveform.sourceAnalysisPath = canonical;
+            waveform.sourceFingerprint = fingerprint;
+            waveform.sourceSize = expected;
+            waveform.sourceModifiedMs = modified.toMSecsSinceEpoch();
+        }
+    }
+    return result;
+}
+} // namespace mixxx::rekordbox
diff --git a/src/library/rekordbox/rekordboxanlzreader.h b/src/library/rekordbox/rekordboxanlzreader.h
new file mode 100644
index 0000000..3f131e7
--- /dev/null
+++ b/src/library/rekordbox/rekordboxanlzreader.h
@@ -0,0 +1,41 @@
+#pragma once
+
+#include "library/rekordbox/rekordboxruntimecatalog.h"
+
+#include <QString>
+#include <QStringList>
+
+namespace mixxx::rekordbox {
+
+// Neutral, bounded view over the existing Kaitai ANLZ parser. This is not a
+// Track/Deck adapter. Decodes PPTH/PQTZ and the documented PCOB/PCO2 cue
+// fields, but not waveform samples.
+struct AnlzReadResult {
+    bool containerValid{false};
+    bool partial{false};
+    bool hasPathSection{false};
+    bool hadBeatGrid{false};
+    bool hadCueSection{false};
+    bool hadWaveformSection{false};
+    QString exportedAudioPath;
+    QList<RuntimeBeat> beats;
+    // cues applies the per-container preference: nonempty PCO2, else PCOB.
+    // The format-specific lists let the session apply the same preference
+    // across associated DAT/EXT/2EX siblings without duplicating cues.
+    QList<RuntimeCue> cues;
+    QList<RuntimeCue> pcobCues;
+    QList<RuntimeCue> pco2Cues;
+    QList<RuntimeWaveform> waveforms;
+    QList<RuntimeAnlzSection> unmappedSections;
+    QStringList diagnostics;
+};
+
+enum class AnlzWaveformReadMode { InlineBody, Descriptor };
+
+AnlzReadResult readAnlz(const QByteArray& bytes);
+// Descriptor mode streams waveform payloads through a bounded hash buffer, never
+// retaining them. Unmapped sections keep their existing bounded raw behavior.
+AnlzReadResult readAnlzFile(const QString& path,
+        AnlzWaveformReadMode mode = AnlzWaveformReadMode::InlineBody);
+
+} // namespace mixxx::rekordbox
diff --git a/src/library/rekordbox/rekordboxdatabase.cpp b/src/library/rekordbox/rekordboxdatabase.cpp
new file mode 100644
index 0000000..1c232c3
--- /dev/null
+++ b/src/library/rekordbox/rekordboxdatabase.cpp
@@ -0,0 +1,458 @@
+#include "library/rekordbox/rekordboxdatabase.h"
+
+#include <QFile>
+#include <QSet>
+#include <QtEndian>
+#include <QTextCodec>
+#include <algorithm>
+#include <stdexcept>
+
+namespace mixxx::rekordbox {
+namespace {
+constexpr qint64 kMaxDatabaseBytes = 512LL * 1024 * 1024;
+constexpr quint32 kPageHeaderBytes = 40;
+constexpr quint32 kRowGroupBytes = 36;
+
+quint32 u32(const QByteArray& bytes, qint64 offset) {
+    if (offset < 0 || offset > bytes.size() - 4) {
+        throw std::runtime_error("Truncated DeviceSQL integer");
+    }
+    return qFromLittleEndian<quint32>(bytes.constData() + offset);
+}
+quint16 u16(const QByteArray& bytes, qint64 offset) {
+    if (offset < 0 || offset > bytes.size() - 2) {
+        throw std::runtime_error("Truncated DeviceSQL integer");
+    }
+    return qFromLittleEndian<quint16>(bytes.constData() + offset);
+}
+
+QString readString(const QByteArray& bytes, qint64 offset, qint64 end) {
+    if (offset < 0 || offset >= end || end > bytes.size()) {
+        throw std::runtime_error("DeviceSQL string offset is outside its row");
+    }
+    const quint8 kind = static_cast<quint8>(bytes.at(offset));
+    qint64 start = offset + 1;
+    qint64 length = (kind >> 1) - 1;
+    bool utf16 = false;
+    if (kind == 0x40 || kind == 0x90) {
+        if (end - offset < 4) {
+            throw std::runtime_error("Truncated DeviceSQL long-string header");
+        }
+        start = offset + 4;
+        length = static_cast<qint64>(u16(bytes, offset + 1)) - 4;
+        utf16 = kind == 0x90;
+    } else if ((kind & 1) == 0) {
+        throw std::runtime_error("Unsupported DeviceSQL string encoding");
+    }
+    if (length < 0 || length > end - start || (utf16 && length % 2 != 0)) {
+        throw std::runtime_error("DeviceSQL string exceeds its row");
+    }
+    QTextCodec::ConverterState state;
+    auto* codec = QTextCodec::codecForName(utf16 ? "UTF-16LE" : "UTF-8");
+    QString result = codec->toUnicode(bytes.constData() + start, length, &state);
+    if (state.invalidChars != 0 || state.remainingChars != 0) {
+        throw std::runtime_error("Invalid DeviceSQL string data");
+    }
+    while (result.endsWith(QChar::Null)) {
+        result.chop(1);
+    }
+    if (result.contains(QChar::Null)) {
+        throw std::runtime_error("Embedded null in DeviceSQL string");
+    }
+    return result;
+}
+
+void validate(DatabaseDocument* document) {
+    const auto& bytes = document->bytes;
+    if (bytes.size() < 28 || bytes.size() > kMaxDatabaseBytes) {
+        throw std::runtime_error("Missing, truncated or oversized DeviceSQL header");
+    }
+    const quint32 pageSize = u32(bytes, 4);
+    const quint32 tableCount = u32(bytes, 8);
+    if (pageSize < kPageHeaderBytes + kRowGroupBytes || pageSize > 65536 ||
+            bytes.size() % pageSize != 0 || tableCount > (pageSize - 28) / 16) {
+        throw std::runtime_error("Invalid DeviceSQL page size or table count");
+    }
+    if (u32(bytes, 24) != 0) {
+        throw std::runtime_error("Unsupported DeviceSQL header variant");
+    }
+    const quint32 pageCount = bytes.size() / pageSize;
+    document->sequence = u32(bytes, 20);
+    QSet<quint32> visitedPages;
+    for (quint32 table = 0; table < tableCount; ++table) {
+        const qint64 entry = 28 + table * 16;
+        const quint32 type = u32(bytes, entry);
+        quint32 page = u32(bytes, entry + 8);
+        const quint32 last = u32(bytes, entry + 12);
+        if (page == 0 && last == 0) {
+            continue;
+        }
+        if (last == 0 || last >= pageCount) {
+            throw std::runtime_error("DeviceSQL last-page reference is outside the file");
+        }
+        for (;;) {
+            if (page == 0 || page >= pageCount) {
+                throw std::runtime_error("DeviceSQL page reference is outside the file");
+            }
+            const qint64 base = static_cast<qint64>(page) * pageSize;
+            if (u32(bytes, base) != 0 || u32(bytes, base + 4) != page) {
+                throw std::runtime_error("Invalid DeviceSQL page identity");
+            }
+            if (u32(bytes, base + 8) != type) {
+                document->diagnostics.append(QStringLiteral(
+                        "Table %1 ends at a page belonging to another table").arg(type));
+                break;
+            }
+            if (visitedPages.contains(page)) {
+                throw std::runtime_error("Cyclic or shared DeviceSQL page chain");
+            }
+            visitedPages.insert(page);
+            const auto flags = static_cast<quint8>(bytes.at(base + 27));
+            if ((flags & 0x40) == 0) {
+                const quint32 rowCount = u16(bytes, base + 24) & 0x1fff;
+                const quint32 groups = (rowCount + 15) / 16;
+                if (groups > (pageSize - kPageHeaderBytes) / kRowGroupBytes) {
+                    throw std::runtime_error("DeviceSQL row index overlaps page header");
+                }
+                const quint32 heapEnd = pageSize - groups * kRowGroupBytes;
+                QList<DatabaseRow> rows;
+                for (quint32 group = 0; group < groups; ++group) {
+                    const quint32 end = pageSize - group * kRowGroupBytes;
+                    const quint16 present = u16(bytes, base + end - 4);
+                    for (quint32 slot = 0; slot < 16; ++slot) {
+                        if ((present & (1 << slot)) == 0) {
+                            continue;
+                        }
+                        const quint32 row = group * 16 + slot;
+                        const quint32 offset = kPageHeaderBytes +
+                                u16(bytes, base + end - 6 - 2 * slot);
+                        if (row >= rowCount || offset >= heapEnd) {
+                            throw std::runtime_error("Invalid live DeviceSQL row offset");
+                        }
+                        rows.append({type, page, row, base + offset, 0});
+                    }
+                }
+                // Variable strings may not spill into the next live row/index.
+                std::sort(rows.begin(), rows.end(), [](const auto& a, const auto& b) {
+                    return a.offset < b.offset;
+                });
+                for (qsizetype i = 0; i < rows.size(); ++i) {
+                    const qint64 end = i + 1 < rows.size()
+                            ? rows.at(i + 1).offset : base + heapEnd;
+                    rows[i].size = end - rows[i].offset;
+                    if (rows[i].size <= 0) {
+                        throw std::runtime_error("Duplicate DeviceSQL row offsets");
+                    }
+                    document->rows.append(rows.at(i));
+                }
+            }
+            if (page == last) {
+                break;
+            }
+            page = u32(bytes, base + 12);
+        }
+    }
+    document->pageSize = pageSize;
+}
+} // namespace
+
+DatabaseDocument readDatabase(QByteArray bytes, DatabaseKind kind) {
+    DatabaseDocument result;
+    result.kind = kind;
+    result.bytes = std::move(bytes);
+    try {
+        validate(&result);
+    } catch (const std::exception& e) {
+        result.error = QString::fromUtf8(e.what());
+        result.pageSize = 0;
+        result.rows.clear();
+    }
+    return result;
+}
+
+PlaylistIndex readPlaylistIndex(const DatabaseDocument& document) {
+    PlaylistIndex result;
+    try {
+        if (!document.valid() || document.kind != DatabaseKind::Main) {
+            throw std::runtime_error("Playlist index requires a valid main DeviceSQL database");
+        }
+        for (const auto& row : document.rows) {
+            const auto& bytes = document.bytes;
+            if (row.tableType == 7) {
+                if (row.size < 21) {
+                    throw std::runtime_error("Truncated DeviceSQL playlist row");
+                }
+                DatabasePlaylist playlist{u32(bytes, row.offset + 12),
+                        u32(bytes, row.offset), u32(bytes, row.offset + 8),
+                        u32(bytes, row.offset + 16) != 0,
+                        readString(bytes, row.offset + 20, row.offset + row.size)};
+                if (playlist.id == 0 || result.playlists.contains(playlist.id)) {
+                    throw std::runtime_error("Invalid or duplicate DeviceSQL playlist identity");
+                }
+                result.playlists.insert(playlist.id, std::move(playlist));
+            } else if (row.tableType == 8) {
+                if (row.size < 12) {
+                    throw std::runtime_error("Truncated DeviceSQL playlist entry");
+                }
+                const auto position = u32(bytes, row.offset);
+                const auto track = u32(bytes, row.offset + 4);
+                const auto playlist = u32(bytes, row.offset + 8);
+                if (result.tracks[playlist].contains(position)) {
+                    result.diagnostics.append(QStringLiteral("Playlist %1 has tied track positions")
+                                                      .arg(playlist));
+                }
+                result.tracks[playlist].insert(position, track);
+            }
+        }
+        QMap<quint32, QSet<quint32>> siblingPositions;
+        for (const auto& playlist : result.playlists) {
+            if (siblingPositions[playlist.parentId].contains(playlist.sortOrder)) {
+                result.diagnostics.append(QStringLiteral("Folder %1 has tied sort positions")
+                                                  .arg(playlist.parentId));
+            }
+            siblingPositions[playlist.parentId].insert(playlist.sortOrder);
+            QSet<quint32> ancestors;
+            auto parent = playlist.id;
+            while (parent != 0 && result.playlists.contains(parent)) {
+                if (ancestors.contains(parent) || ancestors.size() >= 256) {
+                    throw std::runtime_error("Cyclic or excessively nested DeviceSQL playlist tree");
+                }
+                ancestors.insert(parent);
+                parent = result.playlists.value(parent).parentId;
+            }
+            if (parent != 0) {
+                result.diagnostics.append(QStringLiteral("Playlist %1 has missing parent %2")
+                                                  .arg(playlist.id).arg(parent));
+            }
+        }
+        for (auto entries = result.tracks.cbegin(); entries != result.tracks.cend(); ++entries) {
+            if (!result.playlists.contains(entries.key())) {
+                result.diagnostics.append(QStringLiteral("Entries refer to missing playlist %1")
+                                                  .arg(entries.key()));
+            }
+        }
+    } catch (const std::exception& e) {
+        result.error = QString::fromUtf8(e.what());
+        result.playlists.clear();
+        result.tracks.clear();
+    }
+    return result;
+}
+
+TrackIndex readTrackIndex(const DatabaseDocument& document) {
+    TrackIndex result;
+    if (!document.valid() || document.kind != DatabaseKind::Main) {
+        result.error = QStringLiteral("Track index requires a valid main DeviceSQL database");
+        return result;
+    }
+    QMap<quint32, QMap<quint32, QString>> names;
+    QMap<quint32, quint32> albumArtists;
+    const auto& bytes = document.bytes;
+    for (const auto& row : document.rows) {
+        if (row.tableType == 0 || row.tableType == 7 || row.tableType == 8) {
+            continue;
+        }
+        try {
+            quint32 id;
+            qint64 textOffset;
+            qint64 minimumTextOffset = 0;
+            const auto at = row.offset;
+            switch (row.tableType) {
+            case 1: // Genres
+            case 4: // Labels
+            case 13: // Artwork paths
+                if (row.size < 5) throw std::runtime_error("Truncated named metadata row");
+                id = u32(bytes, at);
+                textOffset = 4;
+                break;
+            case 5: // Keys
+                if (row.size < 9) throw std::runtime_error("Truncated key row");
+                id = u32(bytes, at);
+                textOffset = 8;
+                break;
+            case 2: // Artist names may have near or far offsets.
+                if (row.size < 10) throw std::runtime_error("Truncated artist row");
+                id = u32(bytes, at + 4);
+                if (u16(bytes, at) == 100) {
+                    if (row.size < 12) throw std::runtime_error("Truncated far artist name");
+                    textOffset = u16(bytes, at + 10);
+                    minimumTextOffset = 12;
+                } else {
+                    textOffset = static_cast<quint8>(bytes.at(at + 9));
+                    minimumTextOffset = 10;
+                }
+                break;
+            case 3: // Albums
+                if (row.size < 22) throw std::runtime_error("Truncated album row");
+                id = u32(bytes, at + 12);
+                albumArtists.insert(id, u32(bytes, at + 8));
+                textOffset = static_cast<quint8>(bytes.at(at + 21));
+                minimumTextOffset = 22;
+                break;
+            case 6: // Device color names, not RGB samples.
+                if (row.size < 9) throw std::runtime_error("Truncated color row");
+                id = u16(bytes, at + 5);
+                textOffset = 8;
+                break;
+            default:
+                result.diagnostics.append(QStringLiteral("Metadata table %1 retained as raw DeviceSQL rows")
+                                                  .arg(row.tableType));
+                continue;
+            }
+            if (textOffset < minimumTextOffset || textOffset >= row.size) {
+                throw std::runtime_error("Named metadata offset is outside its payload");
+            }
+            if (names[row.tableType].contains(id)) {
+                throw std::runtime_error("Duplicate named metadata identity");
+            }
+            names[row.tableType].insert(id, readString(bytes, at + textOffset, at + row.size));
+        } catch (const std::exception& e) {
+            result.diagnostics.append(QStringLiteral("Metadata page %1 row %2: %3")
+                                              .arg(row.pageIndex).arg(row.rowIndex).arg(QString::fromUtf8(e.what())));
+        }
+    }
+    for (const auto& row : document.rows) {
+        if (row.tableType != 0) continue;
+        try {
+            if (row.size < 136) throw std::runtime_error("Truncated track row");
+            const auto at = row.offset;
+            DatabaseTrack track;
+            track.id = u32(bytes, at + 72);
+            if (track.id == 0 || result.tracks.contains(track.id)) {
+                throw std::runtime_error("Invalid or duplicate track identity");
+            }
+            auto& metadata = track.metadata;
+            metadata.insert("rekordbox_id", static_cast<double>(track.id));
+            metadata.insert("pdb_fixed_header_raw", QString::fromLatin1(bytes.mid(at, 136).toBase64()));
+            for (const auto& field : std::initializer_list<std::pair<const char*, int>>{
+                         {"sample_rate", 8}, {"composer_id", 12}, {"file_size", 16},
+                         {"artwork_id", 28}, {"key_id", 32}, {"original_artist_id", 36},
+                         {"label_id", 40}, {"remixer_id", 44}, {"bitrate", 48},
+                         {"track_number", 52}, {"tempo_hundredths", 56}, {"genre_id", 60},
+                         {"album_id", 64}, {"artist_id", 68}}) {
+                metadata.insert(field.first, static_cast<double>(u32(bytes, at + field.second)));
+            }
+            for (const auto& field : std::initializer_list<std::pair<const char*, int>>{
+                         {"disc_number", 76}, {"play_count", 78}, {"year", 80},
+                         {"sample_depth", 82}, {"duration", 84}}) {
+                metadata.insert(field.first, u16(bytes, at + field.second));
+            }
+            metadata.insert("color_id", static_cast<quint8>(bytes.at(at + 88)));
+            metadata.insert("rating", static_cast<quint8>(bytes.at(at + 89)));
+            const auto tempo = u32(bytes, at + 56);
+            if (tempo > 0 && tempo <= 50000) {
+                metadata.insert("bpm", tempo / 100.0);
+            } else {
+                result.diagnostics.append(QStringLiteral("Track %1 BPM is absent or outside the import range (0, 500]")
+                                                  .arg(track.id));
+            }
+            const auto reference = [&](const char* field, quint32 table, quint32 id) {
+                metadata.insert(field, names.value(table).value(id));
+                if (id != 0 && !names.value(table).contains(id)) {
+                    result.diagnostics.append(QStringLiteral("Track %1 has missing %2 reference %3")
+                                                      .arg(track.id).arg(QString::fromLatin1(field)).arg(id));
+                }
+            };
+            reference("artist", 2, u32(bytes, at + 68));
+            reference("album", 3, u32(bytes, at + 64));
+            reference("genre", 1, u32(bytes, at + 60));
+            reference("key", 5, u32(bytes, at + 32));
+            reference("color_name", 6, static_cast<quint8>(bytes.at(at + 88)));
+            reference("composer", 2, u32(bytes, at + 12));
+            reference("original_artist", 2, u32(bytes, at + 36));
+            reference("remixer", 2, u32(bytes, at + 44));
+            reference("label", 4, u32(bytes, at + 40));
+            reference("artwork_path", 13, u32(bytes, at + 28));
+            metadata.insert("album_artist_id", static_cast<double>(albumArtists.value(u32(bytes, at + 64))));
+            constexpr const char* stringNames[] = {"isrc", "texter", "unknown_string_2",
+                    "unknown_string_3", "unknown_string_4", "message", "kuvo_public",
+                    "autoload_hot_cues", "unknown_string_8", "unknown_string_9",
+                    "date_added", "release_date", "mix_name", "unknown_string_13",
+                    "analysis_path", "analysis_date", "comment", "title", "unknown_string_18",
+                    "file_name", "file_path"};
+            QList<quint16> offsets;
+            for (int i = 0; i < 21; ++i) offsets.append(u16(bytes, at + 94 + 2 * i));
+            for (int i = 0; i < 21; ++i) {
+                const auto offset = offsets.at(i);
+                if (offset == 0) continue;
+                qint64 end = at + row.size;
+                for (const auto next : offsets) {
+                    if (next > offset) end = std::min(end, at + next);
+                }
+                try {
+                    if (offset < 136 || offset >= row.size) {
+                        throw std::runtime_error("Track string offset is outside its payload");
+                    }
+                    QString text;
+                    const auto field = at + offset;
+                    if (i == 0 && end - field >= 5 &&
+                            static_cast<quint8>(bytes.at(field)) == 0x90 &&
+                            bytes.at(field + 4) == 3) {
+                        // ISRC: long 0x90 header, then 0x03, ASCII and NUL.
+                        // The declared length still bounds the special payload.
+                        const auto length = u16(bytes, field + 1);
+                        if (length < 6 || length > end - field) {
+                            throw std::runtime_error("Invalid ISRC length");
+                        }
+                        const auto start = field + 5;
+                        const auto nul = bytes.indexOf('\0', start);
+                        if (nul < start || nul >= field + length) {
+                            throw std::runtime_error("Unterminated ISRC");
+                        }
+                        for (auto pos = start; pos < nul; ++pos) {
+                            if (static_cast<quint8>(bytes.at(pos)) > 0x7f) {
+                                throw std::runtime_error("Non-ASCII ISRC");
+                            }
+                        }
+                        text = QString::fromLatin1(bytes.constData() + start, nul - start);
+                    } else {
+                        text = readString(bytes, at + offset, end);
+                    }
+                    metadata.insert(stringNames[i], text);
+                } catch (const std::exception& e) {
+                    result.diagnostics.append(QStringLiteral("Track %1 %2: %3")
+                                                      .arg(track.id).arg(stringNames[i]).arg(QString::fromUtf8(e.what())));
+                    if (offset >= 136 && at + offset < end) {
+                        metadata.insert(QString::fromLatin1(stringNames[i]) + "_raw",
+                                QString::fromLatin1(bytes.mid(at + offset, end - at - offset).toBase64()));
+                    }
+                }
+            }
+            track.filePath = metadata.value("file_path").toString();
+            track.analysisPath = metadata.value("analysis_path").toString();
+            if (track.filePath.isEmpty()) throw std::runtime_error("Track has no usable audio path");
+            result.tracks.insert(track.id, std::move(track));
+        } catch (const std::exception& e) {
+            result.diagnostics.append(QStringLiteral("Track page %1 row %2: %3")
+                                              .arg(row.pageIndex).arg(row.rowIndex).arg(QString::fromUtf8(e.what())));
+        }
+    }
+    result.diagnostics.removeDuplicates();
+    return result;
+}
+
+DatabaseDocument readDatabaseFile(const QString& path, DatabaseKind kind) {
+    QFile file(path);
+    if (!file.open(QIODevice::ReadOnly) || file.size() > kMaxDatabaseBytes) {
+        DatabaseDocument result;
+        result.kind = kind;
+        result.error = QStringLiteral("Cannot read DeviceSQL database: %1").arg(path);
+        return result;
+    }
+    const auto expectedSize = file.size();
+    const auto bytes = file.read(expectedSize + 1);
+    if (bytes.size() != expectedSize || file.size() != expectedSize) {
+        DatabaseDocument result;
+        result.kind = kind;
+        result.error = QStringLiteral("DeviceSQL database changed while reading");
+        return result;
+    }
+    if (file.error() != QFileDevice::NoError) {
+        DatabaseDocument result;
+        result.kind = kind;
+        result.error = file.errorString();
+        return result;
+    }
+    return readDatabase(bytes, kind);
+}
+} // namespace mixxx::rekordbox
