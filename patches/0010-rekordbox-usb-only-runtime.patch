+    auto locked = lockMutex(&m_qMutex);
+    VERIFY_OR_DEBUG_ASSERT(pWaveformImporter) {
+        return ImportStatus::Complete;
+    }
+    DEBUG_ASSERT(!m_pWaveformImporterPending);
+    m_pWaveformImporterPending = std::move(pWaveformImporter);
+    if (m_pWaveformImporterPending->isEmpty()) {
