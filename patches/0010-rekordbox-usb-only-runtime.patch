+void TrackDAO::initialize(const QSqlDatabase& database) {
+    DAO::initialize(database);
+    m_externalTrackSourcesAvailable = false;
+    SqlTransaction transaction(database);
+    if (!transaction) {
+        kLogger.warning() << "Failed to initialize external track source storage";
+        return;
+    }
+    QSqlQuery query(database);
+    // A local companion table keeps older Mixxx library columns compatible.
+    if (!query.exec(QStringLiteral(
+                "CREATE TABLE IF NOT EXISTS external_track_sources ("
+                "track_id INTEGER PRIMARY KEY REFERENCES library(id) ON DELETE CASCADE,"
+                "payload TEXT NOT NULL)"))) {
+        LOG_FAILED_QUERY(query);
+        return;
+    }
+    // SQLite foreign-key enforcement is connection-specific and may be off.
+    // Keep the companion table correct independently of that setting.
+    if (!query.exec(QStringLiteral(
+                "CREATE TRIGGER IF NOT EXISTS external_track_sources_after_library_delete "
+                "AFTER DELETE ON library BEGIN "
+                "DELETE FROM external_track_sources WHERE track_id=OLD.id; END"))) {
+        LOG_FAILED_QUERY(query);
+        return;
+    }
+    if (!query.exec(QStringLiteral(
+                "DELETE FROM external_track_sources "
+                "WHERE track_id NOT IN (SELECT id FROM library)"))) {
+        LOG_FAILED_QUERY(query);
+        return;
+    }
+    if (!transaction.commit()) {
+        kLogger.warning() << "Failed to commit external track source storage initialization";
+        return;
+    }
+    m_externalTrackSourcesAvailable = true;
+}
+
+namespace {
+bool saveExternalSource(const QSqlDatabase& database, TrackId id, const QJsonObject& source) {
+    if (!mixxx::TrackRecord::isValidExternalSource(source)) {
+        kLogger.warning() << "Refusing to persist invalid external source for track" << id;
+        return false;
+    }
+    QSqlQuery query(database);
+    if (source.isEmpty()) {
+        query.prepare(QStringLiteral("DELETE FROM external_track_sources WHERE track_id=:id"));
+    } else {
+        const auto payload = QJsonDocument(source).toJson(QJsonDocument::Compact);
+        DEBUG_ASSERT(payload.size() <= mixxx::TrackRecord::kMaxExternalSourcePayloadBytes);
+        query.prepare(QStringLiteral(
+                "INSERT OR REPLACE INTO external_track_sources "
+                "(track_id,payload) VALUES (:id,:payload)"));
+        query.bindValue(":payload", QString::fromUtf8(payload));
+    }
+    query.bindValue(":id", id.toVariant());
+    if (!query.exec()) {
+        LOG_FAILED_QUERY(query);
+        return false;
+    }
+    return true;
+}
