-            }
-        } else {
-            midi.sendShortMsg((0x96+channel), 0x20+DJCi500.slicerButton[deck], 0x62);
-        }
-    } else {
-        DJCi500.slicerAlreadyJumped[deck] = false;
-        DJCi500.slicerPreviousBeatsPassed[deck] = 0;
-    }
-};
