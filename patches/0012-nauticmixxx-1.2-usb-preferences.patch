+                result->firstAudibleSecond = (range.start() + i) / rate;
+            }
+            auto& column=result->columns[bin];
+            column.minimum=std::min(column.minimum,value);
+            column.maximum=std::max(column.maximum,value);
+        }
+    }
+    return result;
