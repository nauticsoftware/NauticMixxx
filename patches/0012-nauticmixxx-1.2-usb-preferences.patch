-        if (loopEnabled) {
-            engine.setValue(group, "reloop_toggle", true);
-        }
-        engine.setValue(group, "beatjump", beatsToJump);
-        // This sadly does not work.
-        // engine.setValue(group, "loop_move", -beatsToJump);
-        if (loopEnabled) {
-            engine.setValue(group, "reloop_toggle", true);
-        }
-        midi.sendShortMsg((0x96+(deck % 2)), 0x20+index, 0x62);
-    } // if value
