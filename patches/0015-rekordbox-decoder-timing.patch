+            anlzPcp2(2, 2, 0, 1000, {}, 0)});
+    bytes += anlzCueList(true, 0, {anlzPcp2(0, 1, 0, 0xffffffffu, {}, 0),
+            anlzPcp2(0, 2, 0, 10, {}, 0)});
+    putAnlz32(&bytes, 8, bytes.size());
