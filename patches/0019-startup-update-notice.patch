+void MixxxMainWindow::checkForStartupUpdate() {
+    const auto settings = m_pCoreServices->getSettings();
+    if (!settings->getValue<bool>(ConfigKey("[NauticUpdates]", "CheckOnStartup"), true)) {
+        return;
+    }
+    QList<ControlProxy*> playbackControls;
+    for (const auto& family : {
+                 qMakePair(QStringLiteral("num_decks"), QStringLiteral("[Channel%1]")),
+                 qMakePair(QStringLiteral("num_samplers"), QStringLiteral("[Sampler%1]")),
+                 qMakePair(QStringLiteral("num_preview_decks"), QStringLiteral("[PreviewDeck%1]"))}) {
+        const int count = static_cast<int>(ControlObject::get(ConfigKey("[App]", family.first)));
+        for (int i = 1; i <= count; ++i) {
+            playbackControls.append(new ControlProxy(family.second.arg(i), "play", this));
+        }
+    }
+    playbackControls.append(new ControlProxy("[AutoDJ]", "enabled", this));
+    for (const auto* control : playbackControls) {
+        if (control->toBool()) {
+            return;
+        }
+    }
+
+    const QString currentVersion = QStringLiteral(NAUTICMIX_VERSION);
+    auto* checker = new nautic::StartupUpdateChecker(currentVersion,
+            settings->getValueString(ConfigKey("[NauticUpdates]", "SkippedVersion")),
+            [this, settings, currentVersion, playbackControls](const nautic::UpdateRelease& release) {
+                // Never defer this notification into the mixing session.
+                if (!isVisible() || QApplication::activeModalWidget()) {
+                    return;
+                }
+                for (const auto* control : playbackControls) {
+                    if (control->toBool()) {
+                        return;
+                    }
+                }
+                auto* dialog = new DlgStartupUpdate(currentVersion, release,
+                        [](const QUrl& page) { mixxx::DesktopHelper::openUrl(page); },
+                        [settings](const QString& version) {
+                            settings->setValue(ConfigKey("[NauticUpdates]", "SkippedVersion"),
+                                    version);
+                            settings->save();
+                        },
+                        this);
+                dialog->setAttribute(Qt::WA_DeleteOnClose);
+                for (auto* control : playbackControls) {
+                    control->connectValueChanged(dialog, [dialog](double value) {
+                        if (value > 0.0) {
+                            dialog->reject();
+                        }
+                    });
+                }
+                dialog->show();
+            },
+            this);
+    for (auto* control : playbackControls) {
+        control->connectValueChanged(checker, [checker](double value) {
+            if (value > 0.0) {
+                checker->cancel();
+            }
+        });
+    }
+    checker->check();
 }
 
