+            EXPECT_EQ(available?rx3::phraseColor(PhraseKind::Intro):QColor(Qt::black),image.pixelColor(30*dpr,76*dpr));
+            EXPECT_EQ(available?rx3::phraseColor(PhraseKind::Chorus):QColor(Qt::black),image.pixelColor(90*dpr,76*dpr));
