+TEST(Rx3Overview, PhraseModeUsesExportedIntervalsAndDoesNotInventMissingPhrases) {
+    using namespace mixxx::rekordbox;
+    const QVector<Phrase> phrases{{0,30,PhraseKind::Intro},{30,90,PhraseKind::Chorus}};
