+TEST(Rx3Overview, SummaryUsesGlobalBlueAndRgbModesWithoutThreeBandColors) {
+    using Mode = mixxx::rekordbox::WaveformMode;
+    for (auto mode : {Mode::Blue, Mode::RGB}) {
