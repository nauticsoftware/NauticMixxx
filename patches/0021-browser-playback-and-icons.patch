diff --git a/src/widget/rx3browsericons.h b/src/widget/rx3browsericons.h
new file mode 100644
--- /dev/null
+++ b/src/widget/rx3browsericons.h
@@ -0,0 +1,106 @@
+#pragma once
+
+#include <QPainter>
+#include <QPainterPath>
+#include <QStringList>
+
+namespace rx3 {
+inline QColor browserTrackColor(bool playing, bool played) {
+    return QColor(playing ? "#01FF02" : played ? "#008A01" : "#FFFFFF");
+}
+inline bool isLosslessFileType(const QString& type) {
+    // M4A may contain AAC or ALAC: never infer losslessness from that container.
+    return QStringList{QStringLiteral("wav"), QStringLiteral("wave"),
+            QStringLiteral("aif"), QStringLiteral("aiff"), QStringLiteral("flac"),
+            QStringLiteral("alac")}.contains(type.trimmed().toLower());
+}
+
+// All icons use one 32x32 vector canvas, independent of installed symbol fonts.
+inline void drawBrowserTrackIcon(QPainter* p, const QRectF& rect,
+        const QColor& color, bool playing, bool lossless) {
+    p->save();
+    p->setRenderHint(QPainter::Antialiasing);
+    p->translate(rect.topLeft());
+    p->scale(rect.width()/32, rect.height()/32);
+    p->setPen(Qt::NoPen); p->setBrush(color);
+    if (playing) {
+        p->drawPolygon(QPolygonF{QPointF(10,7), QPointF(25,16), QPointF(10,25)});
+    } else {
+        p->drawEllipse(QRectF(10,22,9,6));
+        p->fillRect(QRectF(17,5,2.2,20), color);
+        QPainterPath flag;
+        flag.moveTo(19,5); flag.cubicTo(20,10,29,10,26,17);
+        flag.cubicTo(25,20,22,20,22,20);
+        flag.cubicTo(27,13,18,13,18,9); flag.closeSubpath();
+        p->drawPath(flag);
+        if (lossless) {
+            // The H sits above-left of the note, never as part of the title.
+            QFont font(QStringLiteral("Arial")); font.setPixelSize(10);
+            p->setFont(font); p->setPen(color);
+            p->drawText(QRectF(2,4,9,12), Qt::AlignCenter, QStringLiteral("H"));
+        }
+    }
+    p->restore();
+}
+
+inline void drawBrowserCategoryIcon(QPainter* p, const QRectF& rect,
+        const QString& label, const QColor& color) {
+    p->save(); p->setRenderHint(QPainter::Antialiasing);
+    p->translate(rect.topLeft()); p->scale(rect.width()/32, rect.height()/32);
+    p->setPen(QPen(color,1.4)); p->setBrush(Qt::NoBrush);
+    const auto list = [&] {
+        p->drawRect(QRectF(4,3,24,26));
+        for (int y : {9,16,23}) {
+            p->drawPoint(QPointF(8,y)); p->drawLine(QPointF(12,y),QPointF(24,y));
+        }
+    };
+    if (label == "ARTIST" || label == "REMIXER") {
+        p->drawEllipse(QPointF(16,9),6,6);
+        p->drawArc(QRectF(4,19,24,16),0,180*16);
+    } else if (label == "ALBUM" || label == "ALBUMS") {
+        p->drawRect(QRectF(4,4,24,24));
+        p->drawEllipse(QPointF(16,16),9,9); p->drawEllipse(QPointF(16,16),2,2);
+    } else if (label == "TRACK" || label == "TRACKS") {
+        drawBrowserTrackIcon(p,QRectF(0,0,32,32),color,false,false);
+    } else if (label == "KEY") {
+        p->drawRect(QRectF(3,3,26,26));
+        QFont font(QStringLiteral("Arial")); font.setPixelSize(19); p->setFont(font);
+        p->drawText(QRectF(3,3,26,26),Qt::AlignCenter,QStringLiteral("b#"));
+    } else if (label == "PLAYLIST" || label == "HISTORY") {
+        list();
+        if (label == "HISTORY") {
+            p->setBrush(QColor("#202020")); p->drawEllipse(QPointF(24,24),7,7);
+            p->setBrush(Qt::NoBrush);
+            p->drawLine(QPointF(24,20),QPointF(24,24)); p->drawLine(QPointF(24,24),QPointF(28,26));
+        }
+    } else if (label == "MATCHING" || label == "RELATED TRACKS") {
+        p->drawEllipse(QRectF(3,12,18,18)); p->drawEllipse(QRectF(12,3,18,18));
+    } else if (label == "FOLDER") {
+        p->drawPolygon(QPolygonF{QPointF(3,7),QPointF(13,7),QPointF(17,11),
+                QPointF(29,11),QPointF(29,28),QPointF(3,28)});
+    } else if (label == "REC" || label == "RECORDING") {
+        p->drawEllipse(QPointF(16,16),12,12); p->drawEllipse(QPointF(16,16),8,8);
+    } else if (label == "SEARCH") {
+        p->drawEllipse(QPointF(13,13),9,9); p->drawLine(QPointF(20,20),QPointF(29,29));
+    } else if (label == "RATING") {
+        p->drawPolygon(QPolygonF{QPointF(16,2),QPointF(20,12),QPointF(31,12),
+                QPointF(22,19),QPointF(25,30),QPointF(16,23),QPointF(7,30),
+                QPointF(10,19),QPointF(1,12),QPointF(12,12)});
+    } else if (label == "COLOR") {
+        p->drawEllipse(QPointF(16,16),12,12);
+        p->drawLine(QPointF(4,16),QPointF(28,16)); p->drawLine(QPointF(16,4),QPointF(16,28));
+    } else if (label == "YEAR" || label == "DATE ADDED") {
+        p->drawRect(QRectF(4,6,24,23)); p->drawLine(QPointF(4,13),QPointF(28,13));
+        p->drawLine(QPointF(10,2),QPointF(10,10)); p->drawLine(QPointF(22,2),QPointF(22,10));
+    } else if (label == "LABEL" || label == "GENRE") {
+        p->drawPolygon(QPolygonF{QPointF(3,4),QPointF(17,4),QPointF(30,17),QPointF(17,30),QPointF(3,16)});
+        p->drawEllipse(QPointF(9,10),2,2);
+    } else if (label == "BPM") {
+        QPainterPath pulse; pulse.moveTo(2,17); pulse.lineTo(9,17); pulse.lineTo(13,5);
+        pulse.lineTo(18,27); pulse.lineTo(23,17); pulse.lineTo(30,17); p->drawPath(pulse);
+    } else {
+        list();
+    }
+    p->restore();
+}
+} // namespace rx3
diff --git a/src/widget/rx3browserplayback.h b/src/widget/rx3browserplayback.h
new file mode 100644
--- /dev/null
+++ b/src/widget/rx3browserplayback.h
@@ -0,0 +1,105 @@
+#pragma once
+
+#include <QElapsedTimer>
+#include <QHash>
+#include <QSet>
+#include <QTimer>
+#include <QUrl>
+#include <cmath>
+
+#include "control/controlobject.h"
+#include "mixer/playerinfo.h"
+#include "track/track.h"
+
+namespace rx3 {
+
+// Session-only browser state. It deliberately ignores Mixxx's dominant-deck
+// play counter, which marks a track immediately, and never writes to the USB.
+class BrowserPlaybackLedger {
+  public:
+    struct Sample {
+        QString group;
+        QString identity;
+        bool playing;
+    };
+    static constexpr double kPlayedSeconds = 60.0;
+
+    void advance(const QList<Sample>& samples, double elapsedSeconds) {
+        m_playing.clear();
+        QSet<QString> present;
+        for (const auto& sample : samples) {
+            present.insert(sample.group);
+            auto& deck = m_decks[sample.group];
+            if (deck.identity != sample.identity) {
+                deck = {sample.identity, 0, false};
+            }
+            // Use elapsed listening time, never the seek position or duration.
+            // Both ends of an interval must be playing the same loaded track.
+            if (sample.playing && deck.playing && std::isfinite(elapsedSeconds) &&
+                    elapsedSeconds > 0 && elapsedSeconds <= 1) {
+                deck.seconds += elapsedSeconds;
+            }
+            deck.playing = sample.playing;
+            if (sample.identity.isEmpty()) continue;
+            if (sample.playing) m_playing.insert(sample.identity);
+            if (deck.seconds >= kPlayedSeconds) m_played.insert(sample.identity);
+        }
+        for (auto it = m_decks.begin(); it != m_decks.end();) {
+            if (!present.contains(it.key())) it = m_decks.erase(it);
+            else ++it;
+        }
+    }
+    bool isPlaying(const QString& identity) const { return m_playing.contains(identity); }
+    bool wasPlayed(const QString& identity) const { return m_played.contains(identity); }
+
+  private:
+    struct Deck { QString identity; double seconds; bool playing; };
+    QHash<QString, Deck> m_decks;
+    QSet<QString> m_playing;
+    QSet<QString> m_played;
+};
+
+class BrowserPlaybackState : public QObject {
+  public:
+    explicit BrowserPlaybackState(QObject* parent) : QObject(parent) {
+        m_elapsed.start();
+        connect(&m_timer, &QTimer::timeout, this, [this] { refresh(); });
+        connect(&PlayerInfo::instance(), &PlayerInfo::trackChanged,
+                this, [this] { refresh(); });
+        m_timer.start(100);
+    }
+    static QString identity(const TrackPointer& track) {
+        if (!track) return {};
+        const auto& binding = track->getSourceBinding();
+        if (binding.sourceType() == mixxx::SourceType::RekordboxUsb) {
+            QUrl url;
+            url.setScheme(QStringLiteral("rekordbox-usb"));
+            url.setHost(binding.sessionIdentifier().uuid().toString(QUuid::WithoutBraces));
+            url.setPath(QStringLiteral("/track/%1").arg(binding.rekordboxId()));
+            return url.toString();
+        }
+        return QUrl::fromLocalFile(track->getLocation()).toString();
+    }
+    bool isPlaying(const QUrl& url) const { return m_ledger.isPlaying(url.toString()); }
+    bool wasPlayed(const QUrl& url) const { return m_ledger.wasPlayed(url.toString()); }
+
+  private:
+    void refresh() {
+        QList<BrowserPlaybackLedger::Sample> samples;
+        const auto loaded = PlayerInfo::instance().getLoadedTracks();
+        for (auto it = loaded.cbegin(); it != loaded.cend(); ++it) {
+            // Preview players and samplers never mark browser tracks as played.
+            if (!it.key().startsWith(QStringLiteral("[Channel"))) continue;
+            const bool available = it.value() && it.value()->isSourceAvailableForPlayback();
+            samples.append({it.key(), identity(it.value()), available &&
+                    ControlObject::get(ConfigKey(it.key(), QStringLiteral("play"))) > 0 &&
+                    ControlObject::get(ConfigKey(it.key(), QStringLiteral("cue_preview"))) == 0});
+        }
+        m_ledger.advance(samples, m_elapsed.restart() / 1000.0);
+    }
+    QTimer m_timer;
+    QElapsedTimer m_elapsed;
+    BrowserPlaybackLedger m_ledger;
+};
+
+} // namespace rx3
diff --git a/src/widget/rx3browseraudio.h b/src/widget/rx3browseraudio.h
new file mode 100644
--- /dev/null
+++ b/src/widget/rx3browseraudio.h
@@ -0,0 +1,13 @@
+#pragma once
+#include "track/taglib/trackmetadata_file.h"
+
+namespace rx3 {
+// AAC and ALAC share the M4A extension. Inspect the MP4 audio properties
+// on a worker thread instead of putting an H on every M4A browser row.
+inline bool isAlacAudioFile(const QString& path) {
+    TagLib::MP4::File file(TAGLIB_FILENAME_FROM_QSTRING(path));
+    const auto* properties = file.audioProperties();
+    return file.isValid() && properties &&
+            properties->codec() == TagLib::MP4::Properties::ALAC;
+}
