 // Note: This is executed whenever you single click on an child item
 // Single clicks will not populate sub folders
+bool BrowseFeature::showUsbFolder(const QString& root, const QString& path) {
+    const QString canonicalRoot=QFileInfo(root).canonicalFilePath();
+    const QString canonicalPath=QFileInfo(path).canonicalFilePath();
+    if(canonicalRoot.isEmpty() || canonicalPath.isEmpty() ||
+            !(canonicalPath==canonicalRoot || canonicalPath.startsWith(canonicalRoot+"/")) ||
+            !QFileInfo(canonicalPath).isDir()) return false;
+    auto access=mixxx::FileAccess(mixxx::FileInfo(canonicalPath));
+    if(!access.isReadable()) return false;
+    m_browseModel.setTransientUsbRoot(canonicalRoot);
+    m_proxyModel.search(QString());
+    m_browseModel.setPath(std::move(access));
+    emit enableCoverArtDisplay(false);
+    emit showTrackModel(&m_proxyModel,false);
+    return true;
+}
