<!DOCTYPE template>
<Template>
  <TrackWidgetGroup>
    <ObjectName>RX3LibraryDeck</ObjectName>
    <Group>[Channel<Variable name="channel"/>]</Group>
    <Layout>vertical</Layout>
    <Children>
      <WidgetGroup><ObjectName>RX3LibraryDeckBody</ObjectName><Layout>horizontal</Layout><Children>
        <WidgetGroup><ObjectName>RX3LibraryDeckTimeBox</ObjectName><Layout>vertical</Layout><Size>100f,0me</Size><SizePolicy>f,me</SizePolicy><Children>
          <Label><ObjectName>RX3LibraryDeckNumber</ObjectName><Text>DECK <Variable name="channel"/></Text><Size>92f,22f</Size><SizePolicy>f,f</SizePolicy></Label>
          <Label><ObjectName>RX3LibraryDeckTimeCaption</ObjectName><Text>REMAIN</Text><Size>0me,15f</Size></Label>
          <NumberPos><ObjectName>RX3LibraryDeckTime</ObjectName><Rx3Format>browse</Rx3Format><Size>0me,34f</Size><Channel><Variable name="channel"/></Channel><Connection><ConfigKey>[Channel<Variable name="channel"/>],playposition</ConfigKey></Connection></NumberPos>
          <WidgetGroup><Size>0me,0me</Size><SizePolicy>me,me</SizePolicy></WidgetGroup>
        </Children></WidgetGroup>
          <Overview><Rx3Overview>true</Rx3Overview>
            <ObjectName>RX3LibraryDeckOverview</ObjectName><Size>0me,0me</Size><SizePolicy>me,me</SizePolicy><Channel><Variable name="channel"/></Channel>
            <BgColor>#050607</BgColor><AxesColor>#00000000</AxesColor>
            <SignalColor>#1d6fe0</SignalColor><SignalLowColor>#0055e1</SignalLowColor><SignalMidColor>#f0a000</SignalMidColor><SignalHighColor>#ffffff</SignalHighColor>
            <SignalRGBLowColor>#0055e1</SignalRGBLowColor><SignalRGBMidColor>#f0a000</SignalRGBMidColor><SignalRGBHighColor>#ffffff</SignalRGBHighColor>
            <PlayedOverlayColor>#99000000</PlayedOverlayColor><PlayPosColor>#ffffffff</PlayPosColor><DefaultMark><Rx3Hotcue>true</Rx3Hotcue><Align>bottom</Align><Color>#00c6ee</Color><TextColor>#000000</TextColor></DefaultMark>
            <Connection><ConfigKey>[Channel<Variable name="channel"/>],playposition</ConfigKey></Connection>
          </Overview>
          <WidgetGroup><ObjectName>RX3LibraryDeckBpmBox<Variable name="channel"/></ObjectName><Connection><ConfigKey>[RX3Display],master<Variable name="channel"/></ConfigKey><BindProperty>highlight</BindProperty></Connection><Layout>vertical</Layout><Size>88f,0me</Size><SizePolicy>f,me</SizePolicy><Children>
            <WidgetGroup><ObjectName>RX3LibraryBpmHeader</ObjectName><Layout>horizontal</Layout><Size>0me,16f</Size><Children>
              <Label><ObjectName>RX3LibraryDeckBpmCaption</ObjectName><Text>BPM</Text></Label>
              <Label><ObjectName>RX3LibraryMaster</ObjectName><Text>MASTER</Text><Connection><ConfigKey>[RX3Display],master<Variable name="channel"/></ConfigKey><BindProperty>visible</BindProperty></Connection></Label>
            </Children></WidgetGroup>
            <Number><ObjectName>RX3LibraryDeckBpm<Variable name="channel"/></ObjectName><Size>0me,38f</Size><Rx3Format>bpm</Rx3Format><Connection><ConfigKey>[Channel<Variable name="channel"/>],track_loaded</ConfigKey><BindProperty>visible</BindProperty></Connection><Connection><ConfigKey>[RX3Display],master<Variable name="channel"/></ConfigKey><BindProperty>highlight</BindProperty></Connection><Connection><ConfigKey>[Channel<Variable name="channel"/>],visual_bpm</ConfigKey></Connection></Number><WidgetGroup><Size>0me,0me</Size><SizePolicy>me,me</SizePolicy></WidgetGroup>
          </Children></WidgetGroup>
        </Children>
      </WidgetGroup>
    </Children>
  </TrackWidgetGroup>
</Template>
